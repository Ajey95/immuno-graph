# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=openai

# OAuth 2.1 discovery configuration
# Set RESOURCE_URI to the public NitroCloud URL for this MCP server.
# Keep OAUTH_REQUIRED=false unless NitroCloud/auth provider credentials are configured.
RESOURCE_URI=http://localhost:3000
AUTH_SERVER_URL=https://auth.example.com
OAUTH_REQUIRED=false
# TOKEN_AUDIENCE=
# TOKEN_ISSUER=
# JWKS_URI=
# INTROSPECTION_ENDPOINT=
# INTROSPECTION_CLIENT_ID=
# INTROSPECTION_CLIENT_SECRET=

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
