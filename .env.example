# Stdio is the default: npm start
# For Streamable HTTP: npm run start:http
HOST=127.0.0.1
PORT=3000

# Required when HOST is not loopback. Use a separate long random secret.
# IMMUNOGRAPH_API_KEY=
# IMMUNOGRAPH_ALLOWED_HOSTS=immunograph.example.org
# IMMUNOGRAPH_ALLOWED_ORIGINS=immunograph.example.org

# Enable only the live providers installed in this deployment.
# RCSB_PDB_ENABLED=true
# PUBCHEM_ENABLED=true
# IEDB_LIVE_ENABLED=true
# RDKIT_ENABLED=true
# MEEKO_ENABLED=true
# VINA_ENABLED=true
# RDKIT_PYTHON_COMMAND=C:\path\to\python.exe
# MEEKO_PYTHON_COMMAND=C:\path\to\python.exe
# VINA_COMMAND=C:\path\to\vina.exe
# DOCKING_COMMAND_TIMEOUT_MS=600000
# See docs/LIVE_WORKFLOWS.md for actual MCP calls and file exports.
