NODE_ENV=development

# Browser-safe value exposed by Vite.
VITE_API_BASE_URL=/api/v1

# Local Fastify process configuration.
API_HOST=127.0.0.1
API_PORT=3000
API_LOG_LEVEL=info

# Local NitroStack process configuration.
MCP_HOST=127.0.0.1
MCP_PORT=3001
MCP_SERVER_URL=http://127.0.0.1:3001/mcp
MCP_REQUEST_TIMEOUT_MS=180000

# Agentic workflow configuration.
# DETERMINISTIC keeps local demos stable without an LLM key.
# LLM enables bounded AI-agent mode when OPENAI_API_KEY is provided.
AGENT_MODE=DETERMINISTIC
LLM_ENABLED=false
# OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=30000

# Local-only persistence paths. Do not commit generated database files.
DATABASE_URL=file:./immunograph.db
ARTIFACT_ROOT=./artifacts

# Non-secret runtime and reproducibility metadata.
DEMO_MODE=true
APPLICATION_VERSION=0.1.0
SPECIFICATION_VERSION=0.8.0
# COMMIT_SHA=
# BUILT_AT=2026-07-24T00:00:00.000Z

# ─── IEDB Live Connector (Researcher Mode) ───────────────────────────────────
# Set IEDB_LIVE_ENABLED=true to enable real live MHC-I / MHC-II predictions
# from the official IEDB Tools API (https://tools.iedb.org/main/tools-api/).
# When false (default), the system uses offline/backup fixture fallback for
# all binding predictions - safe for development and demos.
# Results are labeled LIVE / FIXTURE in the UI and exports.
IEDB_LIVE_ENABLED=false
# IEDB_TIMEOUT_MS=120000          # Per-request timeout in milliseconds
# IEDB_MAX_RESPONSE_BYTES=10485760  # Max IEDB response body (10 MB default)
# IEDB_MHCI_URL=https://tools-cluster-interface.iedb.org/tools_api/mhci/   # Override MHC-I endpoint
# IEDB_MHCII_URL=https://tools-cluster-interface.iedb.org/tools_api/mhcii/ # Override MHC-II endpoint
https://help.openai.com/en/articles/11369540-using-codex-with-your-chatgpt-plan#h_8dd84c836b
# IEDB population coverage is a separate optional live connector.
# IEDB does not publish population coverage in the same stable REST Tools API
# as MHC binding. The supported live path is the official standalone Python
# tool from https://tools.iedb.org/population/download/.
# Local setup:
#   npm run connectors:install:iedb-population
#   npm run connectors:check:iedb-population
#   set IEDB_POPULATION_COVERAGE_ENABLED=true and the script path below.
# If unset, population coverage uses synthetic/fixture backup mode transparently.
IEDB_POPULATION_COVERAGE_ENABLED=false
# IEDB_POPULATION_COVERAGE_URL=https://your-configured-iedb-population-endpoint.example/api
# IEDB_POPULATION_COVERAGE_SCRIPT_PATH=.\\.iedb-tools\\population_coverage\\calculate_population_coverage.py
# IEDB_POPULATION_COVERAGE_PYTHON_COMMAND=python
# IEDB_POPULATION_COVERAGE_TIMEOUT_MS=120000
# IEDB_POPULATION_COVERAGE_MAX_RESPONSE_BYTES=10485760

# MHCflurry Local Connector (Researcher Mode)
# Set MHCFLURRY_ENABLED=true only after installing the MHCflurry CLI and its
# prediction models on the machine/container running apps/mcp.
# This is an open-source local MHC-I predictor path. It does not support MHC-II.
MHCFLURRY_ENABLED=false
# Parent CLI on some installs: MHCFLURRY_COMMAND=mhcflurry
# Direct scan executable on Windows/local venvs:
# MHCFLURRY_COMMAND=.\\.venv-mhcflurry\\Scripts\\mhcflurry-predict-scan.exe
# MHCFLURRY_METHOD_VERSION=2.3.0
# MHCFLURRY_TIMEOUT_MS=120000
# MHCFLURRY_MAX_RESPONSE_BYTES=10485760

# Structure, chemistry, and docking capability flags.
# Current local default uses explicit fixture/cache-safe paths unless live/local
# scientific dependencies are installed and configured.
STRUCTURE_ENABLED=true
RCSB_PDB_ENABLED=false
ALPHAFOLD_DB_ENABLED=false
FPOCKET_ENABLED=false
FPOCKET_COMMAND=fpocket
FREESASA_ENABLED=false
FREESASA_COMMAND=freesasa
MOLSTAR_ENABLED=false

CHEMISTRY_ENABLED=true
PUBCHEM_ENABLED=false
RDKIT_ENABLED=false
RDKIT_PYTHON_COMMAND=python
OPENBABEL_ENABLED=false
OPENBABEL_COMMAND=obabel

DOCKING_ENABLED=true
VINA_ENABLED=false
VINA_COMMAND=vina
PLIP_ENABLED=false
PLIP_COMMAND=plip
DOCKING_FIXTURE_FALLBACK_ENABLED=true
