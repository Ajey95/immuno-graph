{
  "name": "immunograph-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "Standard MCP server for provenance-aware computational epitope research tools",
  "mcpName": "io.github.Ajey95/immunograph",
  "license": "MIT",
  "bin": {
    "immunograph-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "scripts/live",
    "docs",
    ".env.example",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "node --import tsx --test tests/mcp.test.ts",
    "test:all-tools": "node --import tsx scripts/audit-tools.mts",
    "test:semantics": "node --import tsx scripts/audit-tool-semantics.mts",
    "check": "npm test && npm run build && npm run test:all-tools && npm run test:semantics && npm audit --audit-level=high && npm pack --dry-run --silent",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^16.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  },
  "author": "Ajey95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ajey95/immuno-graph.git"
  },
  "engines": {
    "node": ">=20"
  }
}
