NODE_ENV=production
LOG_LEVEL=info

# NitroStack Cloud or container platforms normally provide PORT.
# HOST must bind all interfaces in cloud runtimes.
HOST=0.0.0.0
PORT=3001
MCP_HOST=0.0.0.0
MCP_PORT=3001
MCP_TRANSPORT_TYPE=dual

# Public MCP base URL used by external clients after deployment.
# Replace with the NitroStack Cloud URL once deployed.
MCP_SERVER_URL=https://your-immunograph-mcp.example.com/mcp
MCP_REQUEST_TIMEOUT_MS=180000

# Agentic workflow configuration.
AGENT_MODE=LLM
LLM_ENABLED=true
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=30000

# Cloud MVP connector policy.
IEDB_LIVE_ENABLED=true
IEDB_TIMEOUT_MS=120000
IEDB_MAX_RESPONSE_BYTES=10485760
IEDB_POPULATION_COVERAGE_ENABLED=true
# IEDB_POPULATION_COVERAGE_URL=https://your-configured-iedb-population-endpoint.example/api
IEDB_POPULATION_COVERAGE_SCRIPT_PATH=/opt/iedb/population_coverage/calculate_population_coverage.py
IEDB_POPULATION_COVERAGE_PYTHON_COMMAND=python3
IEDB_POPULATION_COVERAGE_TIMEOUT_MS=120000
IEDB_POPULATION_COVERAGE_MAX_RESPONSE_BYTES=10485760

# Keep MHCflurry disabled until the cloud runtime has Python, the CLI, and models installed.
MHCFLURRY_ENABLED=false
MHCFLURRY_COMMAND=mhcflurry-predict-scan
MHCFLURRY_METHOD_VERSION=2.2.1
MHCFLURRY_TIMEOUT_MS=120000
MHCFLURRY_MAX_RESPONSE_BYTES=10485760

# GraphBepi remains fixture-only in MVP.
GRAPHBEPI_MODE=fixture
EXECUTION_MODE=HYBRID

# Structure, chemistry, and docking capabilities.
STRUCTURE_ENABLED=true
RCSB_PDB_ENABLED=true
ALPHAFOLD_DB_ENABLED=true
FPOCKET_ENABLED=true
FPOCKET_COMMAND=fpocket
FREESASA_ENABLED=true
FREESASA_COMMAND=freesasa
MOLSTAR_ENABLED=true

CHEMISTRY_ENABLED=true
PUBCHEM_ENABLED=true
RDKIT_ENABLED=true
RDKIT_PYTHON_COMMAND=python3
OPENBABEL_ENABLED=true
OPENBABEL_COMMAND=obabel

DOCKING_ENABLED=true
VINA_ENABLED=true
VINA_COMMAND=vina
PLIP_ENABLED=true
PLIP_COMMAND=plipcmd
DOCKING_FIXTURE_FALLBACK_ENABLED=true

# Non-secret reproducibility metadata.
DEMO_MODE=true
APPLICATION_VERSION=0.1.0
SPECIFICATION_VERSION=0.8.0
# COMMIT_SHA=
# BUILT_AT=
