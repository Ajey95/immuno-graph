FROM node:20-bookworm-slim AS deps

WORKDIR /app

COPY package.json package-lock.json tsconfig.json tsconfig.base.json ./
COPY apps/mcp/package.json apps/mcp/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/algorithms/package.json packages/algorithms/package.json
COPY packages/database/package.json packages/database/package.json

RUN npm ci

FROM deps AS build

COPY apps/mcp apps/mcp
COPY packages packages
COPY data data
COPY vitest.config.ts ./

RUN npm run build --workspace @immunograph/mcp

FROM node:20-bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    freesasa \
    openbabel \
    plip \
    python3 \
    python3-matplotlib \
    python3-numpy \
    python3-openbabel \
    python3-pip \
    python3-rdkit \
    autodock-vina \
  && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/Discngine/fpocket.git /tmp/fpocket \
  && make -C /tmp/fpocket \
  && cp /tmp/fpocket/bin/fpocket /usr/local/bin/fpocket \
  && rm -rf /tmp/fpocket

RUN mkdir -p /opt/iedb \
  && curl -fsSL 'https://downloads.iedb.org/tools/retrieve_package.php?tool=population' -o /tmp/iedb-population-coverage.tar.gz \
  && tar -xzf /tmp/iedb-population-coverage.tar.gz -C /opt/iedb \
  && rm /tmp/iedb-population-coverage.tar.gz

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001
ENV MCP_TRANSPORT_TYPE=dual
ENV IEDB_LIVE_ENABLED=true
ENV IEDB_POPULATION_COVERAGE_ENABLED=true
ENV IEDB_POPULATION_COVERAGE_SCRIPT_PATH=/opt/iedb/population_coverage/calculate_population_coverage.py
ENV IEDB_POPULATION_COVERAGE_PYTHON_COMMAND=python3
ENV MHCFLURRY_ENABLED=false
ENV STRUCTURE_ENABLED=true
ENV RCSB_PDB_ENABLED=true
ENV ALPHAFOLD_DB_ENABLED=true
ENV CHEMISTRY_ENABLED=true
ENV PUBCHEM_ENABLED=true
ENV RDKIT_ENABLED=true
ENV RDKIT_PYTHON_COMMAND=python3
ENV OPENBABEL_ENABLED=true
ENV OPENBABEL_COMMAND=obabel
ENV DOCKING_ENABLED=true
ENV VINA_ENABLED=true
ENV VINA_COMMAND=vina
ENV PLIP_ENABLED=true
ENV PLIP_COMMAND=plipcmd
ENV FPOCKET_ENABLED=true
ENV FPOCKET_COMMAND=fpocket
ENV FREESASA_ENABLED=true
ENV FREESASA_COMMAND=freesasa
ENV MOLSTAR_ENABLED=true

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/mcp ./apps/mcp
COPY --from=build /app/packages ./packages
COPY --from=build /app/data ./data
COPY package.json package-lock.json ./

EXPOSE 3001

CMD ["npm", "run", "mcp:start"]
