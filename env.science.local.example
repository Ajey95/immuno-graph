# Local Windows science runtime.
# Copy these values into `.env` when you want the local MCP server to use the
# installed project-local tools instead of fixture fallback.

STRUCTURE_ENABLED=true
RCSB_PDB_ENABLED=true
ALPHAFOLD_DB_ENABLED=true
FPOCKET_ENABLED=true
FPOCKET_COMMAND=scripts/science/fpocket.cmd
FREESASA_ENABLED=true
FREESASA_COMMAND=scripts/science/freesasa.cmd
MOLSTAR_ENABLED=true

CHEMISTRY_ENABLED=true
PUBCHEM_ENABLED=true
RDKIT_ENABLED=true
RDKIT_PYTHON_COMMAND=.venv-science/Scripts/python.exe
OPENBABEL_ENABLED=true
OPENBABEL_COMMAND=scripts/science/obabel.cmd

DOCKING_ENABLED=true
VINA_ENABLED=true
VINA_COMMAND=scripts/science/vina.cmd
PLIP_ENABLED=true
PLIP_COMMAND=scripts/science/plip.cmd
DOCKING_FIXTURE_FALLBACK_ENABLED=true

# Production/NitroStack Docker uses real Linux-native PLIP via PLIP_COMMAND=plipcmd.
# The local Windows PLIP wrapper is conservative because the official PLIP pip
# install fails on Windows while compiling Open Babel bindings.
